# Train Your Gemma Environment Configuration

# Server & App
APP_ENV=development
PORT=8000
HOST=0.0.0.0
MOCK_MODE=true

# Database (SQLite for dev, Postgres for prod)
DATABASE_URL=sqlite:///./data/train_your_gemma.db

# Model and Inference
MODEL_ID=google/gemma-2-2b-it
INFERENCE_BASE_URL=http://localhost:8001/v1
INFERENCE_API_KEY=mock-key

# Verification Sandboxing
VERIFICATION_TIMEOUT_SECONDS=3.0
VERIFICATION_MAX_MEMORY_MB=512

# Training & Queue
MIN_LABELS=150
MIN_FLAW_TYPES=3
MAX_GPU_HOURS_PER_DAY=4.0
ADAPTER_OUTPUT_DIR=./ml/adapters

# Security
SECRET_KEY=change_me_super_secret_session_key_32bytes_min
ADMIN_API_KEY=admin-secret-key-for-internal-operations
